# Конфигурация моста. Скопируйте в `.env` и отредактируйте под себя.
# Используется лаунчером (source .env) и Python-прослойкой (python-dotenv).
PHOTOCRAFT_CONTROL_PORT=7878
PHOTOCRAFT_CONTROL_TOKEN_FILE=/home/shsmad/.config/photocraft/control.token
# Путь к CLI внутри AppImage (без APPIMAGE используется авто-поиск: $PATH или /tmp/.mount_photoch*/usr/bin)
# PHOTOCRAFT_CLI=/tmp/.mount_photochXYZ/usr/bin/photocraft-cli
# PHOTOCRAFT_APPIMAGE=/home/shsmad/soft/artcraft/photocraft-0.8.2-linux-x86_64.AppImage
# Карта/настройки (по умолчанию: config.toml в корне репозитория)
# PHOTOCRAFT_MIDI_CONFIG=/home/shsmad/.config/photocraft-midi/config.toml
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
PHOTOCRAFT_MIDI_LOG=INFO